# Normalize line endings to LF across platforms (host is Windows, dev container is Linux).
* text=auto eol=lf

# Scripts that must stay LF
*.sh    text eol=lf
*.ps1   text eol=lf

# Windows-specific stay CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pfx   binary
