# Discovery tool — optional LLM narrative inference settings.
# Only needed when you run `iauto-discover ... --narrative`. Copy to .env and edit.
# This mirrors the shared modular-inference contract (src/inference/python).

# github | azure_openai | foundry  (default: github — free GitHub Models)
INFERENCE_PROVIDER=github

# --- GitHub Models (free default) ---
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=            # leave blank to use Entra (DefaultAzureCredential)
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Azure AI Foundry ---
# AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/models
# AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini
# AZURE_AI_FOUNDRY_API_KEY=        # leave blank to use Entra

# --- Shared tuning ---
INFERENCE_TIMEOUT=60
INFERENCE_MAX_RETRIES=3
