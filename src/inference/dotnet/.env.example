# Copy to `.env` (gitignored) and fill in the values for your chosen provider.
# The same contract is shared with the Python iauto-inference package.

# Which backend to use: github | azure_openai | foundry
INFERENCE_PROVIDER=github

# --- GitHub Models (free default) ---
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Azure OpenAI (leave API key empty to use Entra ID / DefaultAzureCredential) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Azure AI Foundry (leave API key empty to use Entra ID) ---
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_KEY=

# --- Shared tunables ---
INFERENCE_TIMEOUT=60
INFERENCE_MAX_RETRIES=3
