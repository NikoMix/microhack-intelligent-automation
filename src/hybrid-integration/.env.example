# Hybrid Integration — environment contract (reference)
#
# Copy to `.env` (gitignored) for reference, or map these into the runtime's own config:
#   - Connector (Functions):  use Connector/local.settings.json (see local.settings.json.example)
#   - Logic App (Standard):   use logic-app/local.settings.json
# In Azure these are app settings; the *secret* values arrive via Key Vault references backed
# by the user-assigned managed identity — they are never stored in source or plain app settings.

# ---- On-prem system (the Connector calls this) ----
ONPREM_BASE_URL=http://localhost:5179/
# Secret — supplied at deploy time via Key Vault (onprem-api-key). Leave blank locally.
ONPREM_API_KEY=

# ---- Modular inference (shared IAuto.Inference contract) ----
# Provider is chosen by configuration ONLY. One of: github | azure_openai | foundry.
INFERENCE_PROVIDER=github

# GitHub Models (free default; no image generation used here so it is always eligible).
GITHUB_TOKEN=<github-pat-with-models-read>
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Azure OpenAI (set INFERENCE_PROVIDER=azure_openai). API key optional → Entra ID when omitted.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure AI Foundry (set INFERENCE_PROVIDER=foundry). API key optional → Entra ID when omitted.
# AZURE_AI_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/
# AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini
# AZURE_AI_FOUNDRY_API_KEY=

# ---- Inference tuning (shared) ----
INFERENCE_TIMEOUT=60
INFERENCE_MAX_RETRIES=3
