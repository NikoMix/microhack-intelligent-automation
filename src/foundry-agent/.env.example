# ---------------------------------------------------------------------------
# Lab 4 environment - OFFLINE-FIRST (zero Azure) by default.
# Copy to .env and fill GITHUB_TOKEN to run with the free GitHub Models provider.
# Retrieval defaults to the license-free offline BM25 retriever, so NO Azure AI
# Search is required until you opt into the upgrade below.
# ---------------------------------------------------------------------------

# Generation provider (free default): GitHub Models via shared iauto_inference.
IAUTO_AGENT_RUNTIME=modular
INFERENCE_PROVIDER=github
GITHUB_TOKEN=<your-github-token>
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# ----- OPTIONAL: Azure AI Search upgrade (use --retriever azure, or auto when set) -----
# Uncomment + fill to switch retrieval from offline BM25 to Azure AI Search.
# AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
# AZURE_SEARCH_INDEX=iauto-foundry-kb

# ----- OPTIONAL: telemetry to Application Insights -----
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# ----- OPTIONAL: Azure OpenAI generation via iauto_inference -----
# INFERENCE_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ----- OPTIONAL: native Agent Framework FoundryChatClient runtime -----
# IAUTO_AGENT_RUNTIME=foundry
# AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com/api/projects/<project-name>
# AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini
