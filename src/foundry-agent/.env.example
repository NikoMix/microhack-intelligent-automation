# =============================================================================
# iauto-foundry-agent — example configuration
# Copy to .env (gitignored) and fill in. Every AI capability runs on all three
# providers by CONFIG ONLY — never a code change.
# =============================================================================

# --- Modular inference (shared contract, owned by iauto-inference) -----------
# Provider selector: github | azure_openai | foundry
INFERENCE_PROVIDER=github

# GitHub Models (free default) — get a token at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Azure OpenAI (set INFERENCE_PROVIDER=azure_openai). Omit the key to use Entra ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Foundry (set INFERENCE_PROVIDER=foundry). Omit the key to use Entra ID.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_KEY=

# Shared transport tuning
INFERENCE_TIMEOUT=30
INFERENCE_MAX_RETRIES=2

# --- Retrieval (RAG) ---------------------------------------------------------
# Backend selector: local (default, zero Azure) | azure_search
RETRIEVER_BACKEND=local

# Local fallback index (BM25 over a JSON corpus). Omit the path to use the bundled sample KB.
# KNOWLEDGE_BASE_PATH=./my-knowledge-base.json
RETRIEVAL_TOP_K=4

# Azure AI Search upgrade (set RETRIEVER_BACKEND=azure_search). Omit the key to use Entra ID.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=knowledge-index
AZURE_SEARCH_API_KEY=
# Field mapping — only needed if your index uses different field names.
# AZURE_SEARCH_ID_FIELD=id
# AZURE_SEARCH_TITLE_FIELD=title
# AZURE_SEARCH_CONTENT_FIELD=content
# AZURE_SEARCH_SOURCE_FIELD=source

# --- Agent identity ----------------------------------------------------------
AGENT_NAME=kb-assistant
# AGENT_INSTRUCTIONS=Override the default grounding system prompt here.

# --- Telemetry (optional: OpenTelemetry → Azure Monitor) ---------------------
# Provisioned by infra/bicep/foundry-search. Leave blank for a no-op offline run.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=iauto-foundry-agent
