# Azure AI Search RAG
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX=iauto-foundry-kb

# Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# Default: Agent Framework OpenAI-compatible client via shared iauto_inference raw async client.
IAUTO_AGENT_RUNTIME=modular
INFERENCE_PROVIDER=github
GITHUB_TOKEN=<your-github-token>
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Optional Azure OpenAI through iauto_inference
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional native Agent Framework FoundryChatClient boundary
IAUTO_AGENT_RUNTIME=foundry
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com
AZURE_AI_FOUNDRY_MODEL=gpt-4o-mini
