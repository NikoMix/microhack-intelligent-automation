# Shared inference layer (GitHub Models default)
INFERENCE_PROVIDER=github
GITHUB_TOKEN=replace-with-a-development-token
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Azure OpenAI provider swap
# INFERENCE_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=<optional-use-managed-identity-where-possible>

# Azure AI Foundry provider swap
# INFERENCE_PROVIDER=foundry
# AZURE_AI_FOUNDRY_ENDPOINT=https://<project>.services.ai.azure.com/models
# AZURE_AI_FOUNDRY_MODEL=<model-or-deployment-name>
# AZURE_AI_FOUNDRY_API_KEY=<optional-use-managed-identity-where-possible>
