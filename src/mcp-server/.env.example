# Intelligent-automation MCP server configuration — copy to .env and fill in the active provider.
# This server reuses the modular inference contract; never commit a real .env (it is git-ignored).

# github | azure_openai | foundry
INFERENCE_PROVIDER=github

# --- GitHub Models (free default) ---
# Create a token at https://github.com/settings/tokens (models: read) — or reuse a Codespaces/Actions token.
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Azure OpenAI ---
# Leave AZURE_OPENAI_API_KEY blank to use Entra ID (DefaultAzureCredential).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Foundry (OpenAI-compatible route) ---
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_KEY=

# --- transport tuning (shared inference contract) ---
INFERENCE_TIMEOUT=60
INFERENCE_MAX_RETRIES=3

# --- optional OpenTelemetry tracing (off by default; spans export to stderr) ---
# Set to 1/true/yes/on to emit spans. For Azure Monitor, wire an OTLP exporter instead (see README).
IAUTO_OTEL_ENABLED=
OTEL_SERVICE_NAME=iauto-mcp-server
