# Lab 3 — Document Processing environment template
# Copy to `.env` (gitignored) and fill in. These variables drive the modular
# inference layer and the Document Intelligence client when you run code outside
# the Functions host (for example unit experiments or the inference CLI).
#
# NOTE: the Azure Functions host reads `local.settings.json`, not `.env`. In
# local.settings.json the same keys use the ASP.NET config form with ':' or '__'
# (for example DocumentIntelligence:Endpoint). See
# ../../src/document-processing/IAuto.DocumentProcessing.Functions/local.settings.json.example

# ----------------------------------------------------------------------------
# Modular inference provider (LLM post-processing). Pick ONE provider.
# github = free GitHub Models (default) | azure_openai | foundry
# ----------------------------------------------------------------------------
INFERENCE_PROVIDER=github

# --- GitHub Models (free default) ---
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Azure OpenAI (set INFERENCE_PROVIDER=azure_openai) ---
# Leave AZURE_OPENAI_API_KEY empty to use Entra ID (DefaultAzureCredential).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Azure AI Foundry (set INFERENCE_PROVIDER=foundry) ---
# Leave AZURE_AI_FOUNDRY_API_KEY empty to use Entra ID (DefaultAzureCredential).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_MODEL=
AZURE_AI_FOUNDRY_API_KEY=

# Shared inference tuning (optional).
INFERENCE_TIMEOUT=100
INFERENCE_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# Azure AI Document Intelligence
# Prefer Entra ID: leave the key empty and sign in with `az login` (or use a
# managed identity). Set AZURE_CLIENT_ID to a user-assigned identity client ID
# when running on Azure with one.
# ----------------------------------------------------------------------------
DocumentIntelligence__Endpoint=
DocumentIntelligence__ApiKey=
AZURE_CLIENT_ID=

# ----------------------------------------------------------------------------
# Routing options
# ----------------------------------------------------------------------------
DocumentProcessing__DefaultModelId=prebuilt-invoice
DocumentProcessing__ConfidenceThreshold=0.80
DocumentProcessing__EnableInsights=false
