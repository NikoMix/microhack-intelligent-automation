              "templateHash": "16266510633511581664"
            }
          },
          "parameters": {
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Microsoft Entra principal ID that receives the role assignment."
              }
            },
            "roleDefinitionId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Built-in role definition GUID. Leave empty to use roleName."
              }
            },
            "roleName": {
              "type": "string",
              "defaultValue": "Key Vault Secrets User",
              "allowedValues": [
                "Key Vault Secrets User",
                "Storage Blob Data Contributor",
                "Cognitive Services OpenAI User",
                "Monitoring Metrics Publisher"
              ],
              "metadata": {
                "description": "Well-known built-in role name. Used when roleDefinitionId is empty."
              }
            },
            "principalType": {
              "type": "string",
              "defaultValue": "ServicePrincipal",
              "allowedValues": [
                "Device",
                "ForeignGroup",
                "Group",
                "ServicePrincipal",
                "User"
              ],
              "metadata": {
                "description": "Principal type for the role assignment."
              }
            }
          },
          "variables": {
            "wellKnownRoles": {
              "Key Vault Secrets User": "4633458b-17de-408a-b874-0445c86b69e6",
              "Storage Blob Data Contributor": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
              "Cognitive Services OpenAI User": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
              "Monitoring Metrics Publisher": "3913510d-42f4-4e42-8a64-420c390055eb"
            },
            "selectedRoleDefinitionId": "[if(empty(parameters('roleDefinitionId')), variables('wellKnownRoles')[parameters('roleName')], parameters('roleDefinitionId'))]",
            "roleDefinitionResourceId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('selectedRoleDefinitionId'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('principalId'), variables('selectedRoleDefinitionId'))]",
              "properties": {
                "roleDefinitionId": "[variables('roleDefinitionResourceId')]",
                "principalId": "[parameters('principalId')]",
                "principalType": "[parameters('principalType')]"
              }
            }
          ],
          "outputs": {
            "resourceId": {
              "type": "string",
              "metadata": {
                "description": "Azure resource ID of the created role assignment."
              },
              "value": "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, parameters('principalId'), variables('selectedRoleDefinitionId')))]"
            },
            "roleDefinitionResourceId": {
              "type": "string",
              "metadata": {
                "description": "Role definition resource ID used for the assignment."
              },
              "value": "[variables('roleDefinitionResourceId')]"
            },
            "name": {
              "type": "string",
              "metadata": {
                "description": "Name of the role assignment resource."
              },
              "value": "[guid(resourceGroup().id, parameters('principalId'), variables('selectedRoleDefinitionId'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "metadata": {
        "description": "Function App name for deployment and smoke tests."
      },
      "value": "[variables('functionAppName')]"
    },
    "documentIntelligenceEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Document Intelligence endpoint used by the Function App."
      },
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelligenceName')), '2024-10-01').endpoint]"
    },
    "dataStorageBlobEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Data storage Blob endpoint containing incoming and processed containers."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'dataStorage'), '2025-04-01').outputs.blobEndpoint.value]"
    },
    "incomingContainerName": {
      "type": "string",
      "metadata": {
        "description": "Incoming invoice container name."
      },
      "value": "[variables('incomingContainerName')]"
    },
    "processedContainerName": {
      "type": "string",
      "metadata": {
        "description": "Processed JSON output container name."
      },
      "value": "[variables('processedContainerName')]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace connected through the shared core."
      },
      "value": "[parameters('logAnalyticsWorkspaceId')]"
    }
  }
}