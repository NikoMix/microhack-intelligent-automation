{
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        "no-hardcoded-env-urls": {
          "level": "error"
        },
        "secure-secrets-in-params": {
          "level": "error"
        },
        "use-recent-api-versions": {
          "level": "error"
        },
        "prefer-interpolation": {
          "level": "error"
        },
        "no-unused-params": {
          "level": "error"
        },
        "no-unused-vars": {
          "level": "error"
        }
      }
    }
  }
}
